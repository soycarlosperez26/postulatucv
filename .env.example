# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo se usa en server actions/route handlers, nunca se expone al cliente
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-...
# Opcional: por defecto usa "deepseek-chat" (el que soporta function calling)
DEEPSEEK_MODEL=deepseek-chat

# Nombre del bucket de Supabase Storage donde se guardan los CV originales
SUPABASE_CV_BUCKET=cvs

# URL pública de esta app (se usa para construir el redirect de vuelta
# tras el login con Google). En local déjalo así; en producción pon tu
# dominio real (ej. https://micurriculum.vercel.app).
# OJO: es NEXT_PUBLIC_, así que se hornea en el build. Si la cambias en
# el panel de tu hosting, hay que volver a desplegar para que aplique.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Recarga de créditos por WhatsApp.
# Formato internacional sin + ni espacios (57 = Colombia).
WHATSAPP_NUMBER=573001234567

# Quién puede aprobar recargas en /dashboard/admin/creditos.
# Lista separada por comas. Sin esta variable no hay administradores.
ADMIN_EMAILS=tucorreo@ejemplo.com

# Wompi — DORMIDO: la interfaz no lo usa por ahora, pero el webhook y
# lib/wompi.ts siguen en el código para poder reactivarlo.
# (https://comercios.wompi.co -> Configuración -> Llaves API)
# Usa las llaves pub_test_/test_ mientras pruebas.
WOMPI_PUBLIC_KEY=pub_test_xxx
# Firma que valida el monto en el checkout
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
# Firma con la que se verifican los eventos del webhook. Sin esto no se
# acredita ninguna compra.
WOMPI_EVENTS_SECRET=test_events_xxx

# Google Analytics 4 (Opcional)
# Si no lo configuras, el tracking no se activa.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
